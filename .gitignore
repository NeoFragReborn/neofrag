# === Secrets & config locale (jamais versionnés) ===
#
# `db.php`, `crypt.php`, `password.php`, `email.php`, `neofrag.php` et `url.php` sont écrits par
# l'installateur et propres à chaque déploiement. Une fois le site installé, ils portent le mot de
# passe de la base, la clé de chiffrement et le sel des mots de passe : les suivre, c'est risquer
# de les pousser au premier `git add -A`.
#
# On exclut donc TOUT par défaut, et on nomme les exceptions. Ce sens-là compte : un fichier de
# configuration ajouté demain sera ignoré sans qu'on y pense, alors qu'une liste d'exclusions
# l'aurait laissé passer en silence.
/config/*

# Ce qui, lui, doit vivre dans le dépôt : les gabarits qui montrent la forme de chaque fichier
# sans en porter la valeur, la garde Apache du dossier, et de quoi comprendre tout cela.
!/config/*.php.dist
!/config/.htaccess
!/config/README.md

# === Runtime / généré ===
/backups/*
!/backups/.htaccess
/cache/*
!/cache/.htaccess
/logs/*
!/logs/.gitkeep
!/logs/.htaccess
/upload/*
!/upload/.htaccess
*.map
*.scssc
*.log

# === Dépendances (reproductibles via composer install) ===
/vendor
/node_modules

# === Installeur : verrou runtime (généré au 1er boot, jamais versionné) ===
install/db.txt

# === Outils dev ===
/.phpunit.cache

# === Scratch agents / IDE ===
/.wf-out
/.claude
/.idea
/.vscode
/.playwright-mcp

# === Marketplace : .zip et vignettes régénérés via tools/package-addons.php (pas de bloat binaire) ===
/marketplace/**/*.zip
/marketplace/**/*.jpg

# === Paquets de release (régénérés via tools/build-release.php) ===
/dist

# Fichiers de sauvegarde d'édition, ne jamais versionner
*.bak
*.bak/

# Graphify : graphe de connaissance genere depuis le code (graph.json, rapport, cache).
# Artefact de generation, 42 Mo, reconstructible en ~55 s par `/graphify .` — pas versionne.
graphify-out/

# === Le bot Discord (bot/) ===
# Ses dépendances et sa compilation se refont par `npm ci && npm run build` ; son `.env` porte sa
# clé d'accès au site, en clair.
/bot/node_modules
/bot/dist
/bot/.env
/dist-bot
