# === Secrets & config locale (jamais versionnés) ===
# `/config` couvre tout le dossier : db.php, crypt.php, password.php, email.php, neofrag.php
# et url.php sont générés par l'installeur et propres à chaque déploiement.
/config

# === Runtime / généré ===
/backups/*
!/backups/.htaccess
/cache
/logs/*
!/logs/.gitkeep
!/logs/.htaccess
/upload/*
!/upload/.htaccess
*.map
*.scssc
*.log

# === Dépendances (reproductibles via composer install) ===
/vendor
/node_modules

# === Installeur : verrou runtime (généré au 1er boot, jamais versionné) ===
install/db.txt

# === Outils dev ===
/.phpunit.cache

# === Scratch agents / IDE ===
/.wf-out
/.claude
/.idea
/.vscode
/.playwright-mcp

# === Marketplace : .zip régénérés via tools/package-addons.php (pas de bloat binaire) ===
/marketplace/**/*.zip

# === Paquets de release (régénérés via tools/build-release.php) ===
/dist

# Fichiers de sauvegarde d'édition, ne jamais versionner
*.bak
*.bak/
