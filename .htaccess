AddDefaultCharset UTF-8
DirectorySlash Off

# Security headers (A9.3 + A9.4)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    # HSTS : envoyé uniquement sur HTTPS (env=HTTPS) — sans effet en dev HTTP.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    # Content-Security-Policy : servie dynamiquement en PHP (index.php) avec un nonce par requête —
    # nécessaire pour retirer 'unsafe-inline' du script-src. Plus de CSP ici (Apache `always set`
    # écraserait l'en-tête PHP). Les réponses non-HTML (statiques/erreurs) n'exécutent pas de script.
</IfModule>

# Accès direct interdit aux fichiers sensibles (SQL d'install/migrations, lockfiles,
# sources compilées, configuration d'outillage, documentation). Lus uniquement côté serveur
# (installeur, app) — jamais en HTTP.
#
# La liste suit celle de la configuration Caddy de production. Elle en était plus courte
# jusqu'au 2026-09-21 : `neon` et `md` manquaient, si bien que sur un hébergement Apache —
# c'est-à-dire la cible de ce produit — toute la documentation interne était lisible, chemins
# de serveur et notes d'exploitation compris. `tools/check-htaccess.php` garde les deux en phase.
<FilesMatch "\.(sql|lock|scssc|map|dist|ini|sh|neon|md)$">
    Require all denied
</FilesMatch>

# Outillage front. Ces trois-là portent des extensions qu'on sert légitimement par ailleurs
# (`.json`, `.js`) : la garde est donc par NOM. Ils ne contiennent aucun secret, mais rien de ce
# qui sert à DÉVELOPPER n'a de raison d'être servi — même règle que `tools/`, `tests/` et `docs/`.
<Files ~ "^(package\.json|package-lock\.json|eslint\.config\.js|playwright\.config\.js)$">
    Require all denied
</Files>

RewriteEngine On
RewriteBase "/"

RewriteRule index\.php - [L]

# Bibliothèques tierces vendorisées (TinyMCE, CodeMirror) : servies en statique par Apache, en
# contournant le routeur d'assets PHP — qui interpréterait les « <?php »/« <?= » présents dans
# certains .min.js (ex. TinyMCE codesample) et bootstraperait le framework par fichier (lent).
# On retire d'abord le préfixe de langue éventuel (/fr/js/... -> js/...), puis on sert directement.
RewriteRule ^[a-z]{2}/(js/(?:tinymce|codemirror)/.+)$ $1 [L]
RewriteRule ^(js/(?:tinymce|codemirror)/.+)$ - [L]

##Allow direct access to specific directories
#RewriteCond %{REQUEST_URI} ^/(dir1|dir2)/
#RewriteRule .* - [L,QSA]

RewriteCond %{REQUEST_URI} !^/(backups|cache|logs)/

##Allow direct access to specific files
#RewriteCond %{REQUEST_FILENAME} /file1\.php [OR]
#RewriteCond %{REQUEST_FILENAME} /file2\.php [OR]

RewriteCond %{REQUEST_FILENAME} !\.(css|js|php)$
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule .* - [L,QSA]

RewriteRule .* index.php [E=REMOTE_USER:%{HTTP:Authorization},E=CONTEXT:%{CONTEXT_PREFIX},L,QSA]
