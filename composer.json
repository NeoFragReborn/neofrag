{
    "name": "neofragreborn/neofrag",
    "description": "NeoFrag Reborn — CMS modulaire pour communautés gaming, continuité de NeoFrag (base Alpha 0.2.4)",
    "type": "project",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "bacon/bacon-qr-code": "^3.1",
        "ezyang/htmlpurifier": "^4.19",
        "jdorn/sql-formatter": "^1.2",
        "league/commonmark": "^2.8",
        "phpmailer/phpmailer": "^6.12",
        "planetteamspeak/ts3-php-framework": "^1.3",
        "pragmarx/google2fa": "^9.0",
        "scssphp/scssphp": "^2.0",
        "socialconnect/auth": "^3.4",
        "xpaw/php-source-query-class": "^6.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:headless": "phpunit --testsuite headless",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "stan:baseline": "php tools/stan-baseline.php",
        "smoke": "php tools/check-smoke.php"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    }
}
