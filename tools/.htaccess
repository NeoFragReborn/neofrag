# Les outils d'administration : jamais servis en HTTP.
#
# Migrations, sauvegardes, vidage de cache, extraction de schéma : exécutés par
# n'importe qui, ils abîment le site. Chacun porte sa garde `PHP_SAPI !== 'cli'` — les 59,
# vérifié le 2026-09-21 — et ce fichier est la seconde.
#
# La production tourne sous Caddy, dont la configuration refuse déjà `/tools/`. Ce fichier est
# l'équivalent pour Apache, c'est-à-dire pour les hébergements mutualisés que ce produit vise —
# où il n'existait pas avant le 2026-09-21. Sur un hébergement où `AllowOverride None` est imposé,
# il est ignoré : chaque outil refuse de lui-même toute exécution hors ligne de commande.

<IfModule mod_authz_core.c>
	Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
