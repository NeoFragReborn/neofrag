# Normalisation des fins de ligne. Le dépôt stocke en LF quelle que soit la plateforme du
# contributeur : `core.autocrlf` est un réglage local, donc non fiable d'une machine à l'autre
# (le clone de développement actuel est sous Windows avec autocrlf=false — sans ce fichier,
# un contributeur Linux verrait des diffs entiers de fichiers non modifiés).
* text=auto eol=lf

*.php    text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.neon   text eol=lf
*.txt    text eol=lf
.htaccess text eol=lf

# Scripts shell : LF obligatoire (un CRLF casse le shebang).
*.sh     text eol=lf

# Binaires : ni conversion de fin de ligne, ni diff textuel.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.zip    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.pdf    binary

# Statistiques de langage GitHub. Les bibliothèques front embarquées ne sont pas du code du
# projet : sans ces marqueurs, le dépôt s'affiche comme majoritairement « JavaScript » à cause
# de TinyMCE et CodeMirror, ce qui donne une fausse idée de la nature du CMS.
js/tinymce/**      linguist-vendored
js/codemirror/**   linguist-vendored
js/flatpickr/**    linguist-vendored
vendor/**          linguist-vendored
fonts/**           linguist-vendored
css/fonts/**       linguist-vendored
css/icons/**       linguist-vendored
*.min.js           linguist-vendored
*.min.css          linguist-vendored
docs/**            linguist-documentation

# `git archive` — c'est ce qui produit les tarballs « Source code » attachés automatiquement à
# chaque release GitHub. On en retire ce qui ne sert qu'au développement, pour que quelqu'un qui
# télécharge la source n'hérite pas de l'outillage de CI.
# Attention : cela n'affecte QUE les archives. Ces fichiers restent visibles dans le dépôt.
# Les vrais paquets d'installation sont produits par tools/build-release.php (cf. docs/RELEASING.md).
/.github               export-ignore
/tests                 export-ignore
/docs/internal         export-ignore
/.gitattributes        export-ignore
/.gitignore            export-ignore
/.dockerignore         export-ignore
/phpunit.xml           export-ignore
/phpstan.neon          export-ignore
/phpstan-base.neon     export-ignore
/package.json          export-ignore
/package-lock.json     export-ignore
/eslint.config.js      export-ignore
/playwright.config.js  export-ignore
/phpstan-baseline.neon export-ignore
/phpstan-bootstrap.php export-ignore
