# Defense-in-depth : aucun script ne doit être exécuté/servi depuis les uploads.
# Les fichiers déposés sont validés (MIME + magic bytes) côté applicatif, ceci
# est la barrière serveur en cas de contournement (polyglotte, mauvaise config).

<FilesMatch "(?i)\.(php[0-9]?|phtml|phps|phar|pl|py|cgi|asp|aspx|jsp|sh|exe|com|htaccess)$">
    Require all denied
</FilesMatch>

# Coupe le moteur PHP ici si mod_php est chargé (ignoré sous php-fpm).
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>

# Pas de sniffing de type : un upload n'est jamais réinterprété.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
