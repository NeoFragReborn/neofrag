# Defense-in-depth : aucun script ne doit être exécuté/servi depuis les uploads.
# Les fichiers déposés sont validés (MIME + magic bytes) côté applicatif, ceci
# est la barrière serveur en cas de contournement (polyglotte, mauvaise config).

<FilesMatch "(?i)\.(php[0-9]?|phtml|phps|phar|pl|py|cgi|asp|aspx|jsp|sh|exe|com|htaccess)$">
    Require all denied
</FilesMatch>

# Pas de `php_admin_flag engine off` ici : Apache interdit les directives `php_admin_*` dans un
# .htaccess, et quand PHP tourne en module, CHAQUE fichier de ce dossier répondait 500 — avatars,
# galerie, médias (trouvé par check-serveur-web sur un vrai Apache, 2026-10-04). Le refus ci-dessus
# suffit : aucun script n'est servi, donc aucun n'est exécuté.

# Pas de sniffing de type : un upload n'est jamais réinterprété.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
